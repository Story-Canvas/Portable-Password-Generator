Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

$form = New-Object System.Windows.Forms.Form
$form.Text = "Random Password Generator"
$form.Size = New-Object System.Drawing.Size(370,210)
$form.StartPosition = "CenterScreen"
$form.FormBorderStyle = "FixedDialog"
$form.MaximizeBox = $false

$labelPassword = New-Object System.Windows.Forms.Label
$labelPassword.Location = New-Object System.Drawing.Point(20,20)
$labelPassword.Size = New-Object System.Drawing.Size(150,20)
$labelPassword.Text = "Generated Password:"
$form.Controls.Add($labelPassword)

$textboxPassword = New-Object System.Windows.Forms.TextBox
$textboxPassword.Location = New-Object System.Drawing.Point(20,40)
$textboxPassword.Size = New-Object System.Drawing.Size(300,20)
$textboxPassword.ReadOnly = $true
$form.Controls.Add($textboxPassword)

$checkboxSymbols = New-Object System.Windows.Forms.CheckBox
$checkboxSymbols.Location = New-Object System.Drawing.Point(20,70)
$checkboxSymbols.Size = New-Object System.Drawing.Size(150,20)
$checkboxSymbols.Text = "Include Symbols"
$form.Controls.Add($checkboxSymbols)

$labelLength = New-Object System.Windows.Forms.Label
$labelLength.Location = New-Object System.Drawing.Point(20,100)
$labelLength.Size = New-Object System.Drawing.Size(100,20)
$labelLength.Text = "Password Length:"
$form.Controls.Add($labelLength)

$numericLength = New-Object System.Windows.Forms.NumericUpDown
$numericLength.Location = New-Object System.Drawing.Point(130,100)
$numericLength.Size = New-Object System.Drawing.Size(50,20)
$numericLength.Minimum = 8
$numericLength.Maximum = 21
$numericLength.Value = 8
$form.Controls.Add($numericLength)

$buttonGenerate = New-Object System.Windows.Forms.Button
$buttonGenerate.Location = New-Object System.Drawing.Point(20,130)
$buttonGenerate.Size = New-Object System.Drawing.Size(150,30)
$buttonGenerate.Text = "Generate Password"
$buttonGenerate.Add_Click({
    $passwordLength = $numericLength.Value
    $useSymbols = $checkboxSymbols.Checked
    $password = Generate-Password -Length $passwordLength -IncludeSymbols $useSymbols
    $textboxPassword.Text = $password
})
$form.Controls.Add($buttonGenerate)

$buttonCopy = New-Object System.Windows.Forms.Button
$buttonCopy.Location = New-Object System.Drawing.Point(180,130)
$buttonCopy.Size = New-Object System.Drawing.Size(150,30)
$buttonCopy.Text = "Copy Password"
$buttonCopy.Add_Click({
    if ($textboxPassword.Text -ne "") {
        $textboxPassword.SelectAll()
        $textboxPassword.Copy()
        $labelCopied.Visible = $true
        $timerFadeOut.Start()
    }
})
$form.Controls.Add($buttonCopy)

#Label for "Password copied" notification
$labelCopied = New-Object System.Windows.Forms.Label
$labelCopied.Location = New-Object System.Drawing.Point(180,70)  # Adjusted location
$labelCopied.Size = New-Object System.Drawing.Size(150,20)
$labelCopied.Text = "Password copied"
$labelCopied.Visible = $false
$form.Controls.Add($labelCopied)

#Timer for fading out the "Password copied" label notification
$timerFadeOut = New-Object System.Windows.Forms.Timer
$timerFadeOut.Interval = 200
$timerFadeOut.Add_Tick({
    $alpha = $labelCopied.ForeColor.A
    if ($alpha -gt 10) {
        $labelCopied.ForeColor = [System.Drawing.Color]::FromArgb($alpha - 10, $labelCopied.ForeColor)
    } else {
        $timerFadeOut.Stop()
        $labelCopied.Visible = $false
        $labelCopied.ForeColor = [System.Drawing.Color]::Black
    }
})

function Generate-Password {
    param (
        [int]$Length = 8,
        [bool]$IncludeSymbols = $false
    )

#-----------------------------------------------#
#	Add/remove characters/symbols here          #
#-----------------------------------------------#
    $chars = 'abcdefghijkmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'
    if ($IncludeSymbols) {
        $chars += '!@#$%^&*()+{}[]\<>?'
    }

    $password = ''
    $random = New-Object System.Random
    1..$Length | ForEach-Object {
        $password += $chars[$random.Next(0, $chars.Length)]
    }
    return $password
}

$form.ShowDialog() | Out-Null
